<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="40dp"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/ivOnboardingIllustration"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivOnboardingIllustration"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:text="Discover places your way"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/tvOnboardingDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvOnboardingTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Switch between First-Timer and Advanced modes easily."
        android:textAlignment="center"
        android:textSize="16sp" />

</RelativeLayout>